# Server
HOST=0.0.0.0
PORT=8080
API_KEY=replace-with-a-long-random-secret

# Data
DATABASE_PATH=./data/storage.db
TEMP_DIR=./data/tmp

# Telegram engine
# teleproto is the primary engine; gramjs is the compatibility/fallback engine.
ENGINE_ORDER=teleproto,gramjs
UPLOAD_STRATEGY=least_used
MAX_RETRIES=4
FLOOD_WAIT_MAX_SECONDS=300
UPLOAD_WORKERS=8
DOWNLOAD_WORKERS=8
MAX_FILE_SIZE_MB=4096

# Each account is independent. Add _3, _4, ... without code changes.
# SESSION is a StringSession. The login command prints it for you.
TELEGRAM_ACCOUNT_1_NAME=acc1
TELEGRAM_ACCOUNT_1_API_ID=12345678
TELEGRAM_ACCOUNT_1_API_HASH=your_api_hash
TELEGRAM_ACCOUNT_1_SESSION=
TELEGRAM_ACCOUNT_1_CHANNEL_ID=-1001234567890
TELEGRAM_ACCOUNT_1_ENGINE=auto

# Optional second account
TELEGRAM_ACCOUNT_2_NAME=acc2
TELEGRAM_ACCOUNT_2_API_ID=87654321
TELEGRAM_ACCOUNT_2_API_HASH=your_api_hash
TELEGRAM_ACCOUNT_2_SESSION=
TELEGRAM_ACCOUNT_2_CHANNEL_ID=-1009876543210
TELEGRAM_ACCOUNT_2_ENGINE=auto
