# ======================
# Server
# ======================
HOST=0.0.0.0
PORT=8080
DEBUG=false
API_KEY=change-me-to-a-long-random-string

# ======================
# Database
# ======================
DATABASE_URL=sqlite+aiosqlite:///./data/storage.db

# ======================
# Storage behaviour
# ======================
UPLOAD_STRATEGY=round_robin   # round_robin | least_used | random
MAX_RETRIES=3
UPLOAD_TIMEOUT=300
DOWNLOAD_TIMEOUT=300
MAX_FILE_SIZE_MB=2000         # soft limit (Telegram free = 2048)

# ======================
# Telegram Accounts
# Add as many as you want. Pattern: TELEGRAM_ACCOUNT_{N}_*
# ======================

TELEGRAM_ACCOUNT_1_NAME=acc1
TELEGRAM_ACCOUNT_1_API_ID=12345678
TELEGRAM_ACCOUNT_1_API_HASH=your_api_hash_here
TELEGRAM_ACCOUNT_1_SESSION=sessions/account1
TELEGRAM_ACCOUNT_1_CHANNEL_ID=-1001234567890

TELEGRAM_ACCOUNT_2_NAME=acc2
TELEGRAM_ACCOUNT_2_API_ID=87654321
TELEGRAM_ACCOUNT_2_API_HASH=your_api_hash_here
TELEGRAM_ACCOUNT_2_SESSION=sessions/account2
TELEGRAM_ACCOUNT_2_CHANNEL_ID=-1009876543210

# Example for a third account (just uncomment & fill):
# TELEGRAM_ACCOUNT_3_NAME=acc3
# TELEGRAM_ACCOUNT_3_API_ID=...
# TELEGRAM_ACCOUNT_3_API_HASH=...
# TELEGRAM_ACCOUNT_3_SESSION=sessions/account3
# TELEGRAM_ACCOUNT_3_CHANNEL_ID=-100...
